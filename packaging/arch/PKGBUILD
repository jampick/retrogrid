# Maintainer: jampick <jampick@users.noreply.github.com>
pkgname=retrogrid
pkgver=0.1.0
pkgrel=1
pkgdesc="Cyberpunk NFL gameday console: every live game, the plays that matter as neon diagrams, follows the Omarchy theme"
arch=('any')
url="https://github.com/jampick/retrogrid"
license=('MIT')
# namcap flags python-websockets and python-pyarrow as "may not be needed": both
# are pulled in one layer down. uvicorn refuses to serve /ws without a websocket
# library (Arch's uvicorn does not depend on one), and pandas needs pyarrow to
# read the nflverse parquet files.
depends=('python' 'python-fastapi' 'uvicorn' 'python-websockets' 'python-pandas' 'python-pyarrow'
         'python-pillow' 'python-numpy' 'python-httpx' 'python-platformdirs' 'hicolor-icon-theme')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
checkdepends=('python-pytest' 'python-pytest-asyncio')
optdepends=('chromium: chromeless app window (any Chromium-family browser works)'
            'omarchy: theme-set hook for an instant retune, see /usr/share/retrogrid')
# The sdist carries the built frontend (web/dist) and the prebuilt SIM SUNDAY slate,
# so no node at build time. The GitHub Release asset is byte-identical to PyPI's.
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
        "$pkgname.desktop" "$pkgname.svg" "omarchy-theme-hook.sh")
sha256sums=('eabe58a4bb08b6f17eb2987567407f783eb64e5f2ad66271fb6d7f05b25186c1'
            '054f4eb7259e650c33acea5af3e33932f70548627a82a9dc1260ca4d0b61879b'
            'ca07a0ffa7da6f9fd9fc35eecfddc3ffe36be47fd696dda2973f7c132ac1c8f1'
            '74548fb6bcee2fe1f61bb377d2facb9a29e791c3cc25e534a10b4f6e1d4a736d')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  # The 0.1.0 sdist lacks tests/conftest.py and tests/fixtures/ (setuptools only
  # auto-includes tests/test*.py). Skip the nine files that import them; the
  # other 150 tests run. Drop the ignores once a release ships the full suite.
  python -m pytest -q -p no:cacheprovider \
    --ignore=tests/test_chatter_audio.py --ignore=tests/test_clock.py \
    --ignore=tests/test_console_modes.py --ignore=tests/test_directory.py \
    --ignore=tests/test_espn_provider.py --ignore=tests/test_league.py \
    --ignore=tests/test_play_provider.py --ignore=tests/test_redzone.py \
    --ignore=tests/test_yahoo.py
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 "$srcdir/$pkgname.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm755 "$srcdir/omarchy-theme-hook.sh" "$pkgdir/usr/share/$pkgname/omarchy-theme-hook.sh"
}
